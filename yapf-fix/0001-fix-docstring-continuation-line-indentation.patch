+  def testDocstringContinuationLineIndentation(self):
+    # Regression test for https://github.com/google/yapf/issues/575 : when a
+    # block is re-indented, the docstring's continuation lines and its closing
+    # triple quote must move with the opening line, not stay at their original
+    # indentation.
+    unformatted_code = textwrap.dedent("""\
+        def GetArgs():
+           '''
+           Some docstrings.
+           '''
+           pass
+    """).replace("'''", '"""')
+    expected_formatted_code = textwrap.dedent("""\
+        def GetArgs():
+          '''
+          Some docstrings.
+          '''
+          pass
+    """).replace("'''", '"""')
+    llines = yapf_test_helper.ParseAndUnwrap(unformatted_code)
+    self.assertCodeEqual(expected_formatted_code, reformatter.Reformat(llines))
+
+  def testNestedDocstringContinuationLineIndentation(self):
+    # A multiline docstring nested in a method must keep its body and closing
+    # quote aligned with the (re-indented) opening quote, preserving any extra
+    # relative indentation in the body (issue #575).
+    unformatted_code = textwrap.dedent("""\
+        class C:
+            def m(self):
+                '''Summary.
+
+                Example::
+
+                    x = 1
+                '''
+                return x
+    """).replace("'''", '"""')
+    expected_formatted_code = textwrap.dedent("""\
+        class C:
+
+          def m(self):
+            '''Summary.
+
+            Example::
+
+                x = 1
+            '''
+            return x
+    """).replace("'''", '"""')
+    llines = yapf_test_helper.ParseAndUnwrap(unformatted_code)
+    self.assertCodeEqual(expected_formatted_code, reformatter.Reformat(llines))
